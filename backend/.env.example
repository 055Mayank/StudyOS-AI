# AI API (OpenAI by default — swap to Gemini by changing llmOrchestrator.js)
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth for Classroom sync
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# App secrets
JWT_SECRET=change_this_to_a_random_secret_string_at_least_32_chars
PORT=3001

# Database (SQLite for local dev, change to postgresql:// for production)
DATABASE_URL=file:./dev.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
USER_STORAGE_QUOTA_MB=500

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=30

# Environment
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
